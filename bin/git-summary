#!/usr/bin/env bash

shopt -s nullglob
set -o pipefail

# Parse command-line options
output_branch=false
do_fetch=false

while getopts "bfh" opt; do
    case "$opt" in
    b)
        output_branch=true
        ;;
    f)
        do_fetch=true
        ;;
    h)
        cat <<EOF
Usage: $(basename "$0") [options]

Options:
  -b    Show the name of the checked out branch for each repo.
  -f    Perform 'git fetch --prune --porcelain' before checking status.
  -h    Show this help message.
EOF
        exit 0
        ;;
    *)
        echo "Usage: $(basename "$0") [-bf]"
        exit 1
        ;;
    esac
done

shift $((OPTIND - 1))

# Colors
GREEN=$'\e[32m'
BLUE=$'\e[34m'
YELLOW=$'\e[33m'
BOLD=$'\e[1m'
RESET=$'\e[0m'

for dir in */; do
    repo="${dir%/}"

    # Skip non-Git directories
    [[ -d "$repo/.git" ]] || continue

    pushd "$repo" >/dev/null || continue

    changed=false
    output=()

    #
    # Fetch
    #
    if $do_fetch; then
        fetch_output=$(git fetch --prune --porcelain --quiet |
            awk '{
                sub("refs/remotes/origin/", "", $NF)
                print $1, $NF
            }')

        if [[ -n "$fetch_output" ]]; then
            changed=true
            output+=("${BLUE}Fetch:${RESET}")
            output+=("${fetch_output}")
            output+=("")
        fi
    fi

    #
    # Status
    #
    status=$(git --no-optional-locks status --short)

    if [[ -n "$status" ]]; then
        changed=true
        output+=("${BLUE}Status:${RESET}")
        output+=("$status")
        output+=("")
    fi

    #
    # Stashes
    #
    stashes=$(git stash list)

    if [[ -n "$stashes" ]]; then
        changed=true
        output+=("${BLUE}Stashes:${RESET}")
        output+=("$stashes")
        output+=("")
    fi

    #
    # Branch
    #
    branch=$(git branch --show-current)
    branch_length="$((${#branch} + 3))" # Add 3 for space and ()

    if [[ "$output_branch" == true ]]; then
        branch="${BOLD}${YELLOW}($branch)${RESET}"
    else
        branch=""
        branch_length=0
    fi

    #
    # Output
    #
    if $changed; then
        printf "%s %s\n" "${YELLOW}${repo}${RESET}" "$branch"
        printf "%*s\n" "$((${#repo} + branch_length))" '' | tr ' ' '-'
        printf "%s\n" "${output[@]}"
    else
        printf "%-18s : %s %s\n" "${BOLD}${GREEN}${repo}" "Clean${RESET}" "$branch"
    fi

    popd >/dev/null
done
